<!DOCTYPE html>
<html>

<head>

    <!-- Title displayed in the browser tab -->
    <title>Note Keeper</title>
    <link rel="stylesheet" href="/styles.css">

</head>

<body>

    <div class="site">

        <header class="header">
            <div class="brand">
                <div class="logo">NK</div>
                <div>
                    <h1>Note Keeper</h1>
                    <div class="subtitle">Quickly add, edit and remove notes</div>
                </div>
            </div>
            <div>
                <small class="subtitle">Local demo — no account needed</small>
            </div>
        </header>

        <div class="main">


    <!--
        Create a flex container.

        Inside this container we will display
        all the notes.
    -->
    <div class="notes">

        <!--
            EJS code.

            "data" comes from app.js:

            res.render("home", {
                data: notes
            });

            forEach() loops through every note.
        -->
        <% data.forEach(element => { %>

            <div class="note">


            <!--
                Form used to UPDATE a note.

                When the user clicks Update,
                the browser sends a POST request to:

                /update
            -->
            <form action="/update" method="post">

                <!--
                    Hidden input.

                    The user cannot see this input.

                    It stores the ID of the note
                    that is being updated.
                -->
                <input
                    type="number"
                    style="display: none;"
                    name="noteId"
                    value="<%= element.noteId %>"
                >

                <!--
                    Textarea displays the current note content.

                    <%= element.noteContent %>

                    is EJS syntax that inserts the
                    note content into the HTML.
                -->
                <textarea
                    rows="6"
                    cols="30"
                    placeholder="Type Here..."
                    name="noteContent"
                ><%= element.noteContent %></textarea>

                <div class="meta">
                    <small>Note ID: <%= element.noteId %></small>
                    <div class="controls">
                        <button type="submit" class="btn primary">Update</button>
                    </div>
                </div>

            </form>


            <!--
                Separate form for deleting a note.

                When the X button is clicked,
                a POST request is sent to:

                /delete
            -->
            <form action="/delete" method="post">

                <!--
                    Hidden input containing the note ID.
                -->
                <input
                    type="number"
                    style="display: none;"
                    name="noteId"
                    value="<%= element.noteId %>"
                >

                <!-- Delete button -->
                <button type="submit" class="btn danger">&#10005;</button>

            </form>


            </div>

        <!--
            End of the forEach loop.

            Everything between:

                &lt;% data.forEach(...) %&gt;

            and:

                &lt;% }) %&gt;

            is repeated for every note.
        -->
        <% }) %>

    </div>

            <aside class="aside">
                <h3>Add Note</h3>
                <p class="subtitle">Write a quick note and click <strong>Add</strong>.</p>
                <form action="/" method="post" class="add-note">
                    <input type="number" style="display:none" name="noteId">
                    <div class="form-row">
                        <textarea name="noteContent" placeholder="Type here..."></textarea>
                    </div>
                    <div style="margin-top:12px;display:flex;justify-content:flex-end">
                        <button type="submit" class="btn primary">Add</button>
                    </div>
                </form>
            </aside>

        </div>

        <footer>
            Built with ❤️ — notes are stored in memory.
        </footer>

    </div>


    <!-- ================================================= -->
    <!-- ADD NEW NOTE -->
    <!-- ================================================= -->

    <h1>Add Note</h1>

    <!--
        Form used to create a new note.

        The form sends a POST request to "/".
    -->
    <form action="/" method="post">

        <!--
            Hidden note ID.

            This isn't actually needed when adding a note
            because app.js generates the ID automatically.
        -->
        <input
            type="number"
            style="display: none;"
            name="noteId"
        >

        <!--
            Textarea where the user enters a new note.
        -->
        <textarea
            rows="6"
            cols="30"
            placeholder="Type Here..."
            name="noteContent"
        ></textarea>

        <br>

        <!-- Submit button -->
        <button type="submit">Add</button>

    </form>

</body>

</html>